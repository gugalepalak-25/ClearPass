# =============================================================================
# ClearPass Environment Configuration
# Privacy-Preserving Fund Risk Verification on NEAR
# =============================================================================

# NEAR Protocol Configuration
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.near.org
NEAR_CONTRACT_ID=clearpass.testnet

# Server Configuration
PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGIN=http://localhost:5173

# Cryptographic Certificate Signing Key (Ed25519)
# If left empty, backend generates a persistent development keypair automatically
CERTIFICATE_SIGNING_PRIVATE_KEY=
CERTIFICATE_SIGNING_PUBLIC_KEY=
ISSUER_NAME=ClearPass Verification Authority

# Optional AI Risk Explainer (OpenAI / Gemini / Anthropic compatible)
# If omitted, deterministic rule-based explanations are used automatically
AI_API_KEY=
AI_MODEL=deterministic-fallback

# Security & Assessment Parameters
MAX_HOP_DEPTH=3
RISK_LIST_PATH=../data/flagged-addresses.demo.json
DEFAULT_CERT_VALIDITY_DAYS=30

